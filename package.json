{
  "name": "agent-browser-runtime",
  "version": "0.3.0",
  "description": "MCP server and TypeScript runtime that gives AI agents a real Chromium browser, with Playwright actions and CDP evidence capture",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "cdp",
    "chromium",
    "browser-automation",
    "ai-agents",
    "claude"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "agent-browser": "dist/cli.js",
    "agent-browser-mcp": "dist/adapters/mcp-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent-sdk": {
      "types": "./dist/adapters/agent-sdk.d.ts",
      "import": "./dist/adapters/agent-sdk.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/core/browser-supervisor.cjs src/core/package-root.cjs dist/core/",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:integration": "jest --runInBand test/integration",
    "test:headless": "jest --runInBand --testNamePattern '^((?!virtual[- ]display).)*$'",
    "browser:install": "node scripts/postinstall.mjs",
    "doctor": "tsx src/cli.ts doctor",
    "smoke": "tsx src/cli.ts smoke",
    "mcp:config": "node dist/cli.js mcp-config",
    "mcp": "tsx src/adapters/mcp-server.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright": "1.61.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.210",
    "@playwright/test": "1.61.1",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.0",
    "jest": "^29.7.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core"
    ]
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.210"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  }
}
